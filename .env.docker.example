# Copy to `.env.docker` for local `docker compose up` testing.
# This runs the "production" settings module inside the container against the
# Postgres service defined in docker-compose.yml, but without HTTPS enforcement
# since there's no TLS termination on localhost.

DJANGO_ENV=production
SECRET_KEY=docker-local-secret-key-do-not-use-in-real-deployment
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://vehicle_system:vehicle_system@db:5432/vehicle_system
CORS_ALLOWED_ORIGINS=http://localhost:3000
TIME_ZONE=UTC
SECURE_SSL_REDIRECT=False
